<Project>
  <PropertyGroup>
    <ThunderstoreName>DrakesTestLab</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesTestLab</RootNamespace>
    <AssemblyName>DrakesTestLab</AssemblyName>
    <Version>0.4.1</Version>
    <BepInPluginName>DrakesTestLab</BepInPluginName>
    <BepInGuid>com.drakemods.testlab</BepInGuid>
    <ModInfoClass>TestLabPlugin</ModInfoClass>
    <Description>QA bench for Valheim modders: a fresh test world in a flat arena with every crafting station, an F9 toolbox, JSON test cases, and a server connect mode with a real second player (pairs with DrakesTestLabServer). Valheim 1.0.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesTestLab</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
  </ItemGroup>
</Project>
