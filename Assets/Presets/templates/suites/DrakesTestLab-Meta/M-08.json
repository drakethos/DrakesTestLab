{
  "name": "M-08 zdo, hoverText, lookAt, hovering, crosshair",
  "description": "",
  "steps": [
    {
      "do": "place",
      "prefab": "piece_workbench",
      "dz": 3,
      "as": "bench"
    },
    {
      "do": "lookAt",
      "target": "bench",
      "distance": 1.5
    },
    {
      "do": "check",
      "check": "hovering",
      "target": "bench",
      "label": "the crosshair is on the workbench"
    },
    {
      "do": "wait",
      "until": {
        "check": "crosshair",
        "contains": "Workbench"
      },
      "timeout": 3,
      "label": "the hover panel fades in: wait for the name at the crosshair"
    },
    {
      "do": "check",
      "check": "crosshair",
      "contains": "Workbench",
      "label": "its name at the crosshair"
    },
    {
      "do": "check",
      "check": "hoverText",
      "target": "bench",
      "contains": "Workbench",
      "label": "its hover text"
    },
    {
      "do": "check",
      "check": "zdo",
      "target": "bench",
      "key": "drake_meta_none",
      "expect": "x",
      "default": "x",
      "label": "a never-saved key reads its default"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesTestLab"
    }
  ]
}