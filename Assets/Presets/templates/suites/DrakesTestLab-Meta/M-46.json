{
  "name": "M-46 Combat tab: fight a monster or Bjornita yourself (screenshots for the docs)",
  "description": "Pictures of the Combat tab for the README and the wiki: the monster setup with its difficulty-database line, and PvP against Bjornita.",
  "steps": [
    {
      "do": "setConfig",
      "guid": "com.drakemods.testlab",
      "values": {
        "Dev/UiOpacity": "1"
      }
    },
    {
      "do": "hook",
      "name": "testlab.combatTabPreset",
      "args": {
        "pvp": false,
        "biome": "Black Forest",
        "foe": "Troll",
        "stars": 0
      }
    },
    {
      "do": "hook",
      "name": "testlab.showTab",
      "args": {
        "tab": "Combat"
      }
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "screenshot",
      "name": "tab-combat"
    },
    {
      "do": "hook",
      "name": "testlab.combatTabPreset",
      "args": {
        "pvp": true,
        "bot": "veteran",
        "gear": "Plains"
      }
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "screenshot",
      "name": "tab-combat-pvp"
    },
    {
      "do": "hook",
      "name": "testlab.closeToolbox"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesTestLab"
    }
  ]
}