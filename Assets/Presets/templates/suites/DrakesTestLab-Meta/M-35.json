{
  "name": "M-35 feature showcase: a real recording, a saved case, Player 2, the manual-check bar (screenshots)",
  "description": "Pictures of the 0.3 features in use, for the README and the wiki.",
  "steps": [
    {
      "do": "setConfig",
      "guid": "com.drakemods.testlab",
      "values": {
        "Dev/UiOpacity": "1"
      }
    },
    {
      "do": "place",
      "prefab": "piece_workbench",
      "dz": 3,
      "dx": -3,
      "as": "bench"
    },
    {
      "do": "give",
      "materialsFor": "piece_chest_wood"
    },
    {
      "do": "give",
      "materialsFor": "sign"
    },
    {
      "do": "give",
      "prefab": "Wood",
      "count": 20
    },
    {
      "do": "give",
      "prefab": "SwordBronze",
      "quality": 2
    },
    {
      "do": "hook",
      "name": "testlab.recordStart",
      "args": {
        "setup": true
      }
    },
    {
      "do": "place",
      "prefab": "piece_chest_wood",
      "dz": 2.5,
      "free": false,
      "as": "box"
    },
    {
      "do": "interact",
      "target": "box",
      "asPlayer": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "store",
      "target": "box",
      "prefab": "Wood",
      "count": 8
    },
    {
      "do": "closeUi"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "place",
      "prefab": "sign",
      "dz": 2.5,
      "dx": 2,
      "free": false,
      "as": "board"
    },
    {
      "do": "interact",
      "target": "board",
      "asPlayer": true
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "type",
      "field": "*",
      "text": "Open for testing",
      "submit": true
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "lookAt",
      "target": "box",
      "distance": 2
    },
    {
      "do": "hook",
      "name": "testlab.recordCheckInventory"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "screenshot",
      "name": "feature-recording-in-game",
      "clean": true
    },
    {
      "do": "hook",
      "name": "testlab.recordStop"
    },
    {
      "do": "hook",
      "name": "testlab.showTab",
      "args": {
        "tab": "Record"
      }
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "feature-recorded-steps"
    },
    {
      "do": "hook",
      "name": "testlab.showTab",
      "args": {
        "tab": "Cases"
      }
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "testlab.saveCase",
      "args": {
        "name": "my-shop-setup",
        "description": "A chest of wood, a sign and a workbench",
        "ui": true
      },
      "contains": "Saved",
      "label": "saved through the Cases tab"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "feature-saved-case"
    },
    {
      "do": "hook",
      "name": "testlab.closeToolbox"
    },
    {
      "do": "peerJoin",
      "name": "Bjornita",
      "dx": 2.5,
      "dz": 3.5,
      "as": "bjornita"
    },
    {
      "do": "wait",
      "seconds": 2.0
    },
    {
      "do": "check",
      "check": "peerConnected",
      "peer": "Bjornita",
      "label": "Bjornita is connected"
    },
    {
      "do": "face",
      "target": "box"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "screenshot",
      "name": "feature-player2-in-world",
      "clean": true
    },
    {
      "do": "hook",
      "name": "testlab.showTab",
      "args": {
        "tab": "Wards"
      }
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "feature-player2-wards-tab"
    },
    {
      "do": "hook",
      "name": "testlab.closeToolbox"
    },
    {
      "do": "peerLeave",
      "name": "Bjornita"
    },
    {
      "do": "face",
      "target": "board"
    },
    {
      "do": "hook",
      "name": "testlab.showCheckpoint",
      "args": {
        "message": "Does the sign say \"Open for testing\"?"
      }
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "screenshot",
      "name": "feature-manual-check-bar"
    },
    {
      "do": "hook",
      "name": "testlab.showCheckpoint",
      "args": {
        "clear": true
      }
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesTestLab"
    }
  ]
}