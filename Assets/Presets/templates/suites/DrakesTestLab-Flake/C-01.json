{
  "name": "C-01 control: with the zone off the same swarm stays",
  "description": "If this fails the flaky situation is no longer real, so a green F-01 would prove nothing.",
  "steps": [
    {
      "do": "setConfig",
      "guid": "com.drakemods.testlab",
      "values": {
        "Arena/QuietZone": "Off"
      }
    },
    {
      "do": "hook",
      "name": "quiet.mark"
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 3
      }
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 5
      }
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 7
      }
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 9
      }
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 11
      }
    },
    {
      "do": "hook",
      "name": "quiet.spawnWild",
      "args": {
        "prefab": "Boar",
        "dist": 13
      }
    },
    {
      "do": "wait",
      "seconds": 2.0
    },
    {
      "do": "hook",
      "name": "quiet.creaturesNear",
      "args": {
        "prefab": "",
        "radius": 40
      }
    },
    {
      "do": "check",
      "check": "lastResult",
      "min": 6,
      "label": "all six are still around the player"
    },
    {
      "do": "hook",
      "name": "quiet.removedSince"
    },
    {
      "do": "check",
      "check": "lastResult",
      "equals": 0,
      "label": "and the zone removed nothing"
    },
    {
      "do": "hook",
      "name": "quiet.clearCreatures",
      "args": {
        "radius": 40
      }
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesTestLab"
    }
  ]
}