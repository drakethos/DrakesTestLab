    <ItemGroup Condition="Exists('$(TargetDir)Assets\Presets\templates')">
      <_TestLabTemplateFiles Include="$(TargetDir)Assets\Presets\templates\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestLabTemplateFiles)" DestinationFolder="$(ThunderstoreFolder)\Assets\Presets\templates\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(_TestLabTemplateFiles)' != ''" />

    <Exec Command="powershell -Command Compress-Archive -Path '$(ThunderstoreFolder)\*' -DestinationPath '$(ZipOutput)' -Force" Condition="'$(CI_SKIP_POST_BUILD)' == ''" />

