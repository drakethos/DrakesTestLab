{
  "name": "LC-01 lab coat: equip and photograph it from every side",
  "timeout": 180,
  "steps": [
    { "do": "invoke", "method": "DrakesTestLab.Cosmetics.LabCoat.Reload", "args": [] },
    { "do": "clearInventory" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "teleport", "dx": 0.01, "dz": 0, "yaw": 180 },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.Stage", "args": [0.5, 14] },
    { "do": "give", "prefab": "Drake_LabCoat", "equip": true },
    { "do": "check", "check": "equipped", "prefab": "Drake_LabCoat", "label": "coat is worn" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [0, 1.0, 2.6, 6] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-front", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [0, 1.35, 1.9, 4] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-front-close", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [20, 0.75, 1.9, 2] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-hem-close", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [50, 1.0, 2.6, 6] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-front-left", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [90, 1.0, 2.6, 6] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-side", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [180, 1.0, 2.6, 6] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-back", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Cosmetics.LabCoat.Describe", "args": [] },
    { "do": "give", "prefab": "ArmorTunic1", "equip": true },
    { "do": "wait", "seconds": 1.0 },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.View", "args": [0, 1.0, 2.6, 6] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "screenshot", "name": "coat-zz-vanilla-tunic-front", "clean": true },
    { "do": "invoke", "method": "DrakesTestLab.Cosmetics.LabCoat.Describe", "args": [] },
    { "do": "invoke", "method": "DrakesTestLab.Util.OrbitCamera.Off", "args": [] },
    { "do": "give", "prefab": "Drake_LabCoat", "count": 1 },
    { "do": "drop", "prefab": "Drake_LabCoat" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "screenshot", "name": "coat-dropped", "clean": true }
  ],
  "asserts": [ { "check": "noErrors", "source": "DrakesTestLab" } ]
}
